<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xceed.Wpf.Toolkit</RootNamespace>
    <AssemblyName>Xceed.Wpf.Toolkit</AssemblyName>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CA1416;WFO1000;SYSLIB0011;SYSLIB0050;SYSLIB0003;CS3021;CS8073</NoWarn>
    <OutputPath>..\..\..\..\bin\</OutputPath>
  </PropertyGroup>

  <!-- The lextudio fork's package. The package id deliberately does not carry the Xceed name: Ms-PL section 3(A)
       grants no right to a contributor's name, logo or trademarks. The assembly and namespaces keep their
       Xceed.Wpf.Toolkit names for now because XAML and consumers reference them as code identifiers; the copyright
       headers and the Ms-PL text stay (section 3(C)). Version 3.7.0 of the community edition plus the fork's changes. -->
  <PropertyGroup>
    <PackageId>LeXtudio.Wpf.Toolkit</PackageId>
    <Version>3.7.2</Version>
    <Authors>Xceed Software Inc. (original authors); LeXtudio</Authors>
    <Description>Toolkit for WPF controls, based on the Community Edition (Ms-PL) of the open-source toolkit originally published by Xceed Software Inc. and maintained here by LeXtudio for LibreWPF on .NET 10: dark theme and property grid fixes, no System.Security.Permissions reference. Not affiliated with or endorsed by Xceed Software Inc.</Description>
    <PackageLicenseFile>license.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/lextudio/wpftoolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lextudio/wpftoolkit</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\license.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Resource Include="**\*.png" />
    <Resource Include="**\*.cur" />
    <EmbeddedResource Include="**\*.bmp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only Zoombox/MaskedTextBox/MessageBox use legacy Code-Access-Security permission demands
         (EnvironmentPermission/UIPermission), which moved out of the BCL into System.Security.Permissions, which LibreWPF.Sdk already references. -->
  </ItemGroup>
</Project>

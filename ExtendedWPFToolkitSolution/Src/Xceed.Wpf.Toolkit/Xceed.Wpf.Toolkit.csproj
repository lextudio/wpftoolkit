<Project Sdk="LibreWPF.Sdk/11.0.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xceed.Wpf.Toolkit</RootNamespace>
    <AssemblyName>Xceed.Wpf.Toolkit</AssemblyName>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CA1416;WFO1000;SYSLIB0011;SYSLIB0050;SYSLIB0003;CS3021;CS8073</NoWarn>
    <OutputPath>..\..\..\..\bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Resource Include="**\*.png" />
    <Resource Include="**\*.cur" />
    <EmbeddedResource Include="**\*.bmp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only Zoombox/MaskedTextBox/MessageBox use legacy Code-Access-Security permission demands
         (EnvironmentPermission/UIPermission), which moved out of the BCL into this package. -->
    <PackageReference Include="System.Security.Permissions" Version="9.0.0" />
  </ItemGroup>
</Project>

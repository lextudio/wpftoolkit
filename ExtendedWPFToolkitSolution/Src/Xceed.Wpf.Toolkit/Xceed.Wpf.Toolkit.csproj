<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xceed.Wpf.Toolkit</RootNamespace>
    <AssemblyName>Xceed.Wpf.Toolkit</AssemblyName>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CA1416;WFO1000;SYSLIB0011;SYSLIB0050;SYSLIB0003;CS3021;CS8073</NoWarn>
    <OutputPath>..\..\..\..\bin\</OutputPath>
  </PropertyGroup>

  <!-- The lextudio fork's package: the assembly keeps its Xceed.Wpf.Toolkit name (XAML namespaces and consumers
       reference it), only the package id says whose build it is. Ms-PL community edition, version 3.7.0 plus the
       fork's changes. -->
  <PropertyGroup>
    <PackageId>LeXtudio.Xceed.Wpf.Toolkit</PackageId>
    <Version>3.7.1</Version>
    <Authors>Xceed Software Inc.; LeXtudio</Authors>
    <Description>Xceed Toolkit for WPF (Community Edition, Ms-PL) as built by the lextudio fork for LibreWPF on .NET 10: dark theme and property grid fixes, no System.Security.Permissions reference.</Description>
    <PackageLicenseFile>license.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/lextudio/wpftoolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lextudio/wpftoolkit</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\license.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Resource Include="**\*.png" />
    <Resource Include="**\*.cur" />
    <EmbeddedResource Include="**\*.bmp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only Zoombox/MaskedTextBox/MessageBox use legacy Code-Access-Security permission demands
         (EnvironmentPermission/UIPermission), which moved out of the BCL into System.Security.Permissions, which LibreWPF.Sdk already references. -->
  </ItemGroup>
</Project>

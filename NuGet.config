<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GitHub Packages NuGet feeds are owner-scoped; OpenAvalon publishes under lextudio. -->
    <add key="openavalon_github" value="https://nuget.pkg.github.com/lextudio/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- NuGet resolves an id from the sources of its most specific (longest) matching pattern, so the LibreWPF.*,
           LibreWinForms.* and ProGPU.* entries below win over "*" for those ids; this exact id is published on
           nuget.org only, outside the openavalon closure. -->
      <package pattern="ProGPU.Scene.Native" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="openavalon_github">
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
